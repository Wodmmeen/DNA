#!/usr/bin/env php
<?php
session_start();
require_once __DIR__ . '/bootstrap/app.php';

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        $migration = new App\Core\Migration($container);
        $migration->run();
        break;
    case 'rollback':
        $steps = $argv[2] ?? 1;
        $migration = new App\Core\Migration($container);
        $migration->rollback((int)$steps);
        break;
    case 'seed':
        $seeder = new App\Core\Seeder($container);
        $seeder->run();
        break;
    case 'migrate:fresh':
        $migration = new App\Core\Migration($container);
        $migration->rollback(100);
        $migration->run();
        $seeder = new App\Core\Seeder($container);
        $seeder->run();
        break;
    default:
        echo "Commands:\n";
        echo "  php console migrate       - Run all pending migrations\n";
        echo "  php console rollback [N]  - Rollback last N migrations\n";
        echo "  php console seed          - Run seeders\n";
        echo "  php console migrate:fresh - Rollback all, migrate, seed\n";
}
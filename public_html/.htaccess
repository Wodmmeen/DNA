RewriteEngine On

# 1. Перенаправляем /assets/ → /public/assets/
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

# 2. Если запрос идёт к существующему файлу в public/ — отдаём его
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^public/(.*)$ public/$1 [L,NC]

# 3. Если запрос идёт к файлу, которого нет в корне — пробуем в public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L,NC]

# 4. Всё остальное → index.php (роутинг)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]